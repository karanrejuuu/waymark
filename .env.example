# Waymark FMCG - Environment Configuration
# Copy this file to .env.local and populate your real Supabase credentials.

# 1. Supabase Project Credentials (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key

# 2. Server-side Secret Role Key (optional, for admin scripts and migrations only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# 3. App Environment
NODE_ENV=development
